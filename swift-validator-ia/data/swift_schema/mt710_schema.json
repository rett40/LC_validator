    },
    "40B": {
      "name": "Form of Documentary Credit",
      "format": "24x 24x",
      "mandatory": true,
      "structure": {
        "lc_type": ["IRREVOCABLE"],
        "confirmation": ["ADDING OUR CONFIRMATION", "WITHOUT OUR CONFIRMATION"]
      }
    },
    "20": {
      "name": "Transferring Bank's Reference",
      "format": "16x",
      "mandatory": true
    },
    "21": {
